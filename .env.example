# Chuỗi kết nối MongoDB (đã có sẵn theo bạn nói)
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net

# Tên database (mặc định tuvi_cache nếu không set)
MONGODB_DB=tuvi_cache

# Chuỗi bí mật để ký JWT - đổi thành chuỗi ngẫu nhiên dài khi deploy
JWT_SECRET=doi-chuoi-nay-thanh-chuoi-ngau-nhien-that-dai-va-bi-mat

# Danh sách email sẽ tự động được cấp quyền admin khi đăng ký/đăng nhập, cách nhau bởi dấu phẩy
ADMIN_EMAILS=admin@tuvi.id.vn
